#: includes/class-caqc-settings.php:175
#, php-format
msgid ""
"%d field still uses an old name. The plugin takes it over on the next "
"activation."
msgid_plural ""
"%d fields still use old names. The plugin takes them over on the next "
"activation."
msgstr[0] ""
"%d campo todavía usa un nombre antiguo. El plugin lo adopta en la próxima "
"activación."
msgstr[1] ""
"%d campos todavía usan un nombre antiguo. El plugin los adopta en la próxima"
" activación."

