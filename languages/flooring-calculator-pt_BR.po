msgid_plural ""
"%d fields still use old names. The plugin takes them over on the next "
"activation."
msgstr[0] ""
"%d campo ainda usa um nome antigo. O plugin o assume na próxima ativação."
msgstr[1] ""
"%d campos ainda usam um nome antigo. O plugin os assume na próxima ativação."

