#
msgid ""
msgstr ""
"Project-Id-Version: Flooring Calculator for WooCommerce readme 1.0.7\n"
"Report-Msgid-Bugs-To: https://wordpress.org/support/plugin/flooring-calculator\n"
"Last-Translator: Patrick Schlesinger <ps@cms-admins.de>\n"
"Language-Team: es_ES\n"
"Language: es\n"
"MIME-Version: 1.0\n"
