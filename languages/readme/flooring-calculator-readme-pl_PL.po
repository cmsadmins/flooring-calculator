msgid "For developers"
msgstr "Dla programistów"

#. Found in description header.
msgid "Features for shop managers"
msgstr "Funkcje dla menedżerów sklepu"

#. Found in description header.
msgid "Features in cart, checkout and orders"
msgstr "Funkcje w koszyku, kasie i zamówieniach"

#. Found in description header.
msgid "Features on the product page"
msgstr "Funkcje na stronie produktu"

